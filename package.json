{
  "name": "life-blackbox-recorder",
  "version": "3.0.0",
  "private": true,
  "description": "LifeRecorder - 저전력 일상 대화 녹음기 (Capacitor Android)",
  "scripts": {
    "setup:android": "cap add android && node scripts/patch-android.mjs && cap sync android",
    "sync": "node scripts/patch-android.mjs && cap sync android",
    "apk": "cd android && gradlew assembleDebug",
    "check": "node scripts/check-source.mjs",
    "test": "node tests/native-ui.mjs && node tests/patch-android.mjs",
    "test:timeline": "mkdir -p /tmp/lbb-timeline-tests && javac -d /tmp/lbb-timeline-tests native/TimelineSegments.java tests/TimelineSegmentsTest.java && java -cp /tmp/lbb-timeline-tests com.lifeblackbox.recorder.TimelineSegmentsTest",
    "test:publication": "node tests/recording-reliability.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
